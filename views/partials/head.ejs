<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · DevLog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <a href="/" class="logo">dev<span>log</span></a>
    <form action="/" method="get" class="search" role="search">
      <label class="visually-hidden" for="q">Search posts</label>
      <input id="q" name="q" type="search" placeholder="Search posts…" value="<%= query %>">
    </form>
    <a href="/posts/new" class="btn">New post</a>
  </header>
  <% if (flash) { %><p class="flash" role="status"><%= flash %></p><% } %>
